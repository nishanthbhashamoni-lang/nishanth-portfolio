# ====================================================================
# Render Web Service / Production Environment Variables
# ====================================================================

# Node Runtime Version (Render automatically reads .node-version or this variable)
NODE_VERSION=20.18.3

# Port and Environment
PORT=5000
NODE_ENV=production
HOST=0.0.0.0

# Persistent Disk Storage Directory
# When using a Render Persistent Disk (e.g., Mount Path: /var/data), set:
DATA_DIR=/var/data

# Security & JSON Web Tokens
# Generate a cryptographically secure random string for production
JWT_SECRET=your_production_jwt_secret_key

# Initial Administrator Credentials (Used ONLY on fresh database bootstrap)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_initial_secure_admin_password

# Cross-Origin Resource Sharing (Optional; defaults to same-origin in production)
CORS_ORIGIN=