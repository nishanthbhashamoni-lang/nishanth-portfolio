# Server Environment Configuration
PORT=5000
NODE_ENV=development

# JWT Secret Key (Generate a cryptographically secure random string in production)
JWT_SECRET=your_secure_jwt_secret_key_change_in_production

# Initial Admin Setup (Used ONLY on initial database creation if no admin user exists)
# In production, change your password immediately after setup
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_strong_password_before_initialization