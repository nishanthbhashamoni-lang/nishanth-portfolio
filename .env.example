# ====================================================================
# Vercel Free Tier ($0) Environment Variables
# ====================================================================

# Port & Node Environment (for local development)
PORT=5000
NODE_ENV=development

# Turso Serverless SQLite Database (100% Free on https://turso.tech)
# In production, create a free database on Turso and enter the URL & token:
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_database_auth_token

# Vercel Blob Storage (100% Free inside Vercel Dashboard -> Storage -> Blob)
# Auto-injected by Vercel when you create a Blob store in your project:
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token_here

# Security & JWT Token Signing
# Generate a cryptographically secure random string (32+ characters)
JWT_SECRET=your_production_jwt_secret_key

# Initial Administrator Credentials (Used on initial database bootstrap)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_initial_secure_admin_password

# Optional CORS Origin
CORS_ORIGIN=